<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Configuration: Strictly enforce HTTPS & System CA Certificates across all traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific Production Domains: Explicitly enforced HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">generativelanguage.googleapis.com</domain>
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <domain includeSubdomains="true">gigverse.io</domain>
        <domain includeSubdomains="true">onrender.com</domain>
        <domain includeSubdomains="true">railway.app</domain>
        <domain includeSubdomains="true">images.unsplash.com</domain>
        <domain includeSubdomains="true">unsplash.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
