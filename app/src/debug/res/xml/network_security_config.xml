<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base Configuration: Enforce HTTPS & System CA Certificates -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local Development Configuration: Allow cleartext HTTP only for local emulator, localhost, and local Wi-Fi IP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.9</domain>
    </domain-config>

    <!-- Development / Local Host Override (Only for Debug) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
